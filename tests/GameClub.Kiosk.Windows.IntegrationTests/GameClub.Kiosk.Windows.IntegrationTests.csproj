<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Npgsql" Version="8.0.7" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <ProjectReference Include="..\..\src\GameClub.Kiosk.Guard\GameClub.Kiosk.Guard.csproj" />
    <ProjectReference Include="..\..\src\GameClub.Kiosk\GameClub.Kiosk.csproj" />
    <ProjectReference Include="..\..\src\GameClub.Kiosk.Core\GameClub.Kiosk.Core.csproj" />
  </ItemGroup>

  <Target Name="CopyKioskExeForSmoke" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net48'">
    <Copy
      SourceFiles="..\..\src\GameClub.Kiosk\bin\$(Configuration)\net48\GameClub.Kiosk.exe"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="..\..\src\GameClub.Kiosk.Guard\bin\$(Configuration)\net48\GameClub.Kiosk.Guard.exe"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <ProjectReference Include="..\GameClub.Server.Tests\GameClub.Server.Tests.csproj" />
    <ProjectReference Include="..\..\src\GameClub.Kiosk.Core\GameClub.Kiosk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
