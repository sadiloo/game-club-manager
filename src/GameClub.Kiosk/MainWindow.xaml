<Window x:Class="GameClub.Kiosk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Checkpoint Kiosk" WindowState="Maximized" WindowStyle="None">
  <Grid Background="#111827">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <StackPanel x:Name="LockPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
    <TextBlock Text="Checkpoint PC Kiosk" Foreground="White" FontSize="28" HorizontalAlignment="Center" />
    <TextBlock x:Name="StatusText" Text="Unpaired — enter operator pairing code" Foreground="#9CA3AF" FontSize="16" Margin="0,12,0,16" TextWrapping="Wrap" TextAlignment="Center" />
    <PasswordBox x:Name="AdminUrlPasswordBox" Height="32" Margin="0,8" ToolTip="Admin password to unlock server URL"/>
    <TextBox x:Name="PairingCodeBox" Height="40" Margin="0,4" FontSize="18" VerticalContentAlignment="Center" />
    <Button Content="Pair station" Height="40" Margin="0,8" Click="OnPairClick"/>
    <Separator Margin="0,16"/>
    <TextBlock Text="Customer login" Foreground="#D1D5DB" FontSize="14"/>
    <TextBox x:Name="LoginNameBox" Height="36" Margin="0,4"/>
    <PasswordBox x:Name="PasswordBox" Height="36" Margin="0,4"/>
    <Button Content="Login" Height="40" Margin="0,8" Click="OnLoginClick"/>
    <TextBox x:Name="ServerUrlBox" Height="32" Margin="0,12" ToolTip="Manual server URL" IsReadOnly="True" />
  </StackPanel>

  <Grid x:Name="LauncherPanel" Grid.Row="1" Visibility="Collapsed" Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="LauncherHeader" Foreground="White" FontSize="22" Text="Games" Margin="0,0,0,8"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBox x:Name="GameSearchBox" Width="280" Height="32" Margin="0,0,8,0" ToolTip="Search games"/>
      <ComboBox x:Name="GameCategoryBox" Width="160" Height="32"/>
    </StackPanel>
    <ListBox x:Name="GameList" Grid.Row="2" Background="#1F2937" Foreground="White" FontSize="16"/>
  </Grid>

  <StackPanel x:Name="PlayingPanel" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right" Visibility="Collapsed" Width="320" Margin="24">
    <TextBlock x:Name="DisplayBalance" Foreground="White" FontSize="20" TextAlignment="Right"/>
    <TextBlock x:Name="DisplayPackage" Foreground="#9CA3AF" FontSize="16" Margin="0,8" TextAlignment="Right"/>
    <TextBlock x:Name="DisplayElapsed" Foreground="#9CA3AF" FontSize="16" TextAlignment="Right"/>
    <TextBlock x:Name="DisplayFreeBand" Foreground="#60A5FA" FontSize="14" Margin="0,12" TextWrapping="Wrap" TextAlignment="Right"/>
    <Button Content="Logout" Height="36" Margin="0,16,0,0" Click="OnLogoutClick"/>
  </StackPanel>

  <TextBlock Grid.Row="2" x:Name="FooterText" Foreground="#4B5563" FontSize="12" Margin="12" Text="F8: server URL (admin password) · F9: safe test exit"/>
  </Grid>
</Window>
