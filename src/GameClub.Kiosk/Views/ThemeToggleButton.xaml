<UserControl x:Class="GameClub.Kiosk.Views.ThemeToggleButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48" Height="48">
  <Button x:Name="Toggle"
          Width="48" Height="48"
          Click="OnToggleClick"
          Background="{DynamicResource Kiosk.SurfaceRaisedBrush}"
          BorderBrush="{DynamicResource Kiosk.BorderBrush}"
          BorderThickness="1">
    <TextBlock x:Name="Icon"
               FontFamily="Segoe MDL2 Assets"
               FontSize="24"
               Foreground="{DynamicResource Kiosk.TextBrush}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
  </Button>
</UserControl>