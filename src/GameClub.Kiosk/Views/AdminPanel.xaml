<UserControl x:Class="GameClub.Kiosk.Views.AdminPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Visibility="Collapsed">
  <Grid Background="{DynamicResource Kiosk.ScrimBrush}">
    <Border Width="420"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Background="{DynamicResource Kiosk.SurfaceBrush}"
            BorderBrush="{DynamicResource Kiosk.BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="32">
      <StackPanel>
        <StackPanel x:Name="RoleStep">
          <TextBlock Text="مدیریت کیوسک"
                     FontSize="20"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Kiosk.TextBrush}"
                     Margin="0,0,0,16"/>
          <Button Content="اپراتور کیوسک"
                  Height="64"
                  Margin="0,0,0,8"
                  Background="{DynamicResource Kiosk.SurfaceRaisedBrush}"
                  BorderBrush="{DynamicResource Kiosk.BorderStrongBrush}"
                  BorderThickness="1"
                  Foreground="{DynamicResource Kiosk.TextBrush}"
                  FontSize="16"
                  Click="OnPickOperator"/>
          <Button Content="مدیر کیوسک"
                  Height="64"
                  Background="{DynamicResource Kiosk.SurfaceRaisedBrush}"
                  BorderBrush="{DynamicResource Kiosk.BorderStrongBrush}"
                  BorderThickness="1"
                  Foreground="{DynamicResource Kiosk.TextBrush}"
                  FontSize="16"
                  Click="OnPickManager"/>
        </StackPanel>
        <StackPanel x:Name="PasswordStep" Visibility="Collapsed">
          <TextBlock x:Name="PasswordTitle"
                     Text="رمز اپراتور کیوسک"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Kiosk.TextBrush}"
                     Margin="0,0,0,12"/>
          <PasswordBox x:Name="AdminPasswordBox"
                       Height="48"
                       FlowDirection="LeftToRight"
                       Background="{DynamicResource Kiosk.SurfaceRaisedBrush}"
                       Foreground="{DynamicResource Kiosk.TextBrush}"
                       VerticalContentAlignment="Center"/>
          <TextBlock x:Name="AdminError"
                     Visibility="Collapsed"
                     TextWrapping="Wrap"
                     Margin="0,8,0,0"
                     Foreground="{DynamicResource Kiosk.DangerBrush}"/>
          <TextBlock x:Name="LockCountdown"
                     Visibility="Collapsed"
                     Margin="0,8,0,0"
                     Foreground="{DynamicResource Kiosk.TextBrush}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,16,0,0">
            <Button Content="ادامه"
                    Height="48"
                    MinWidth="120"
                    Margin="8,0,0,0"
                    Background="{DynamicResource Kiosk.PrimaryBrush}"
                    Foreground="{DynamicResource Kiosk.OnPrimaryBrush}"
                    Click="OnPasswordSubmit"/>
            <Button Content="انصراف"
                    Height="48"
                    MinWidth="120"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Kiosk.BorderStrongBrush}"
                    BorderThickness="1"
                    Foreground="{DynamicResource Kiosk.TextBrush}"
                    Click="OnCancel"/>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="MenuStep" Visibility="Collapsed">
          <TextBlock x:Name="MenuTitle"
                     Text="منوی اپراتور کیوسک"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Kiosk.TextBrush}"
                     Margin="0,0,0,16"/>
          <Button x:Name="OperatorLockButton"
                  Content="قفل"
                  Height="48"
                  Margin="0,0,0,8"
                  Visibility="Collapsed"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Kiosk.BorderStrongBrush}"
                  BorderThickness="1"
                  Foreground="{DynamicResource Kiosk.TextBrush}"
                  Click="OnOperatorLock"/>
          <Button x:Name="OperatorUnlockButton"
                  Content="باز کردن قفل"
                  Height="48"
                  Margin="0,0,0,8"
                  Visibility="Collapsed"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Kiosk.BorderStrongBrush}"
                  BorderThickness="1"
                  Foreground="{DynamicResource Kiosk.TextBrush}"
                  Click="OnOperatorUnlock"/>
          <Button x:Name="RestartMenuButton"
                  Content="راه‌اندازی دوباره"
                  Height="48"
                  Margin="0,0,0,8"
                  Background="{DynamicResource Kiosk.PrimaryBrush}"
                  Foreground="{DynamicResource Kiosk.OnPrimaryBrush}"
                  Click="OnRestart"/>
          <Button x:Name="ServerSettingsButton"
                  Content="تنظیمات سرور"
                  Height="48"
                  Margin="0,0,0,8"
                  Visibility="Collapsed"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Kiosk.BorderStrongBrush}"
                  BorderThickness="1"
                  Foreground="{DynamicResource Kiosk.TextBrush}"
                  Click="OnServerSettings"/>
          <Button x:Name="ExitWindowsButton"
                  Content="خروج به ویندوز"
                  Height="48"
                  Visibility="Collapsed"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Kiosk.DangerBrush}"
                  BorderThickness="1"
                  Foreground="{DynamicResource Kiosk.DangerBrush}"
                  Click="OnExitWindows"/>
          <Button Content="بستن"
                  Height="40"
                  Margin="0,16,0,0"
                  Background="Transparent"
                  Foreground="{DynamicResource Kiosk.MutedBrush}"
                  Click="OnCancel"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>