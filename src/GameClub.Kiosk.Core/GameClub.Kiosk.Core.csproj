<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RootNamespace>GameClub.Kiosk.Core</RootNamespace>
    <AssemblyName>GameClub.Kiosk.Core</AssemblyName>
    <Description>Session, catalog, lockdown, and offline-log logic for the gaming-cafe kiosk. No UI and no Windows-only API.</Description>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameClub.Billing\GameClub.Billing.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <Import Project="..\SqliteWindowsNative.targets" />

</Project>
