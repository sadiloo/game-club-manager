<Window x:Class="GameClub.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="چک‌پوینت — اپراتور"
        FlowDirection="RightToLeft"
        MinWidth="480"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border x:Name="DisconnectBanner"
            Grid.Row="0"
            Visibility="Collapsed"
            Background="#F8E4E8"
            Padding="12"
            BorderBrush="#C41B40"
            BorderThickness="0,0,0,1">
      <TextBlock Text="ارتباط با سرور قطع شد؛ دوباره تلاش می‌شود…"
                 TextWrapping="Wrap"
                 Foreground="#C41B40" />
    </Border>
    <Grid x:Name="PanelHost" Grid.Row="1">
      <Grid x:Name="NativeHost" Visibility="Collapsed" Background="#E8EEF8">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
          <TextBlock x:Name="NativeTitle"
                     Text="در حال باز کردن پنل…"
                     FontSize="16"
                     FontWeight="SemiBold"
                     TextAlignment="Center"
                     Margin="0,0,0,8" />
          <TextBlock x:Name="NativeBody"
                     Text="چند لحظه صبر کنید."
                     TextAlignment="Center"
                     Foreground="#556173"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
      <wv2:WebView2 x:Name="PanelWebView" Visibility="Collapsed" />
    </Grid>
  </Grid>
</Window>