<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GameClub.Kiosk.Guard</RootNamespace>
    <AssemblyName>GameClub.Kiosk.Guard</AssemblyName>
    <Description>Windows service that restarts the kiosk shell and stops escape processes. .NET Framework 4.8.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="..\GameClub.Kiosk.Core\GameClub.Kiosk.Core.csproj" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

  <Import Project="..\SqliteWindowsNative.targets" />

</Project>
