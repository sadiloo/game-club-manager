  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "Branch API key (env GAMECLUB_API_KEY)."
      }
    },
    "schemas": {
      "CheckpointRequest": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ManualSettleRequest": {
        "type": "object",
        "properties": {
          "endAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PlayerCountRequest": {
        "type": "object",
        "properties": {
          "playerCount": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "RateConfigUpdateRequest": {
        "type": "object",
        "properties": {
          "roundingStepToman": {
            "type": "integer",
            "format": "int64"
          },
          "roundingDirection": {
            "type": "string",
            "nullable": true
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RateLineUpdate"
            },
            "nullable": true
          },
          "pcSpecialBandSurchargeToman": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RateLineUpdate": {
        "type": "object",
        "properties": {
          "groupId": {
            "type": "string",
            "nullable": true
          },
          "playMode": {
            "type": "string",
            "nullable": true
          },
          "playerCount": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "isSpecialBand": {
            "type": "boolean"
          },
          "hourlyToman": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "groupId": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "StartRequest": {
        "type": "object",
        "properties": {
          "stationId": {
            "type": "string",
            "nullable": true
          },
          "playerCount": {
            "type": "integer",
            "format": "int32"
          },
          "mode": {
            "type": "string",
            "nullable": true
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Rejected with 400 client_start_time; session start uses server time only."
          }
        },
        "additionalProperties": false
      },
      "UpdateGroupRequest": {
        "type": "object",
        "properties": {
          "groupId": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateStationRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "groupId": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}