<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GameClub.Billing</RootNamespace>
    <AssemblyName>GameClub.Billing</AssemblyName>
    <Description>Pure pricing and session calculation for a PC and console gaming cafe. No UI, database, or clock.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
